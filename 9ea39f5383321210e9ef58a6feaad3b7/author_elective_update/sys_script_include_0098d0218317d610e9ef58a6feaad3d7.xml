        <script><![CDATA[var DueDateValid_UiBuilder = Class.create();
DueDateValid_UiBuilder.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    initialize: function() {
		var dueDate = this.getParameter('due_date');

		var _gdt = new GlideDateTime();
		var gdt = _gdt.getByFormat('dd-MM-yyyy');

		if(gdt > dueDate){
			return 'Das Datum darf nicht in der Vergangenheit liegen.';
		}
    },

    type: 'DueDateValid_UiBuilder'
});]]></script>
