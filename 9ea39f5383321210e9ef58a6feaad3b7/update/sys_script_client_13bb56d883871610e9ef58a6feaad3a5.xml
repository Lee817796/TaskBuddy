        <messages/>
        <name>TaskName-validation</name>
        <order/>
        <script><![CDATA[function onSubmit() {

    var taskName = g_form.getValue('task_name');

    if (taskName == '') {
        g_form.showFieldMsg('task_name', 'Das Feld "Task Name" darf nicht leer sein!', 'error');
        return false;
    }

    return true;
}
