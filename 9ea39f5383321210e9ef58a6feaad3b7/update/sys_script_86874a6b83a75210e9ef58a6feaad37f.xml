        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var setDate = new Date(current.due_date);
    setDate.setHours(0, 0, 0, 0);

    var toDate = new Date();
    toDate.setHours(0, 0, 0, 0);

    gs.info('Fälligkeitsdatum: ' + setDate);
    gs.info('Heutiges Datum: ' + toDate);

    if (setDate < toDate) {
        gs.info('Das Fälligkeitsdatum liegt in der Vergangenheit: ' + setDate);

        gs.addErrorMessage('Das Fälligkeitsdatum kann nicht in der Vergangenheit liegen. Bitte wähle ein zukünftiges Datum.');
        
        return false;
    }

})(current, previous);
]]></script>
