        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var prio = current.priority;
 
    if (prio == 0){
        current.priority_color = "gray";
    }else if (prio == 1){
        current.priority_color = "green";
    }else if(prio == 2){
        current.priority_color = "brown";
    }else if (prio == 3){
        current.priority_color = "yellow";
    }else if (prio == 4){
        current.priority_color = "magenta";
    }

})(current, previous);]]></script>
